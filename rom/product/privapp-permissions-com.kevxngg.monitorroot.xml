<?xml version="1.0" encoding="utf-8"?>
<!--
  Para la APK NORMAL (MonitorRoot.apk) puesta en /product/priv-app/Monitor/.
  Este archivo va en /product/etc/permissions/ (misma partición que la app).
  Sin él, Android no arranca si la app está en priv-app.
-->
<permissions>
    <privapp-permissions package="com.kevxngg.monitorroot">
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
    </privapp-permissions>
</permissions>
