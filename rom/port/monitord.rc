# Monitor service (no root). Goes in /product/etc/init/monitord.rc
service monitord /system/bin/sh /product/bin/monitord.sh
    class late_start
    user root
    group root readproc
    seclabel u:r:monitord:s0
    disabled

# Starts once the system has finished booting (so the installed app can be found)
on property:sys.boot_completed=1
    start monitord
