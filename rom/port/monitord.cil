; Monitor: SELinux domain for the monitord service.
; Append these lines to the END of /product/etc/selinux/product_sepolicy.cil
; The rest of the system stays in Enforcing: only this service gets its own domain.
(type monitord)
(roletype r monitord)
(typeattributeset domain (monitord))
(typepermissive monitord)
; init can start the service in its domain
(allow init monitord (process (transition rlimitinh siginh noatsecure)))
; apps can connect to the socket (the service only accepts Monitor)
(allow appdomain monitord (unix_stream_socket (connectto)))
