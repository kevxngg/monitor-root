// Monitor: edición de sistema para integrar en una ROM (sin root).
// Copia esta carpeta en tu árbol (por ejemplo, packages/apps/Monitor) junto con
// MonitorRoot-system.apk de la última versión en Releases y añade
//   PRODUCT_PACKAGES += Monitor
// a tu device.mk o product.mk.

android_app_import {
    name: "Monitor",
    apk: "MonitorRoot-system.apk",
    // Se vuelve a firmar con la clave de la plataforma de tu ROM (obligatorio:
    // la app usa android.uid.system)
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
    required: ["privapp-permissions-com.kevxngg.monitorroot.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-com.kevxngg.monitorroot.xml",
    src: "privapp-permissions-com.kevxngg.monitorroot.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
